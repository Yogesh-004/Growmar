{
  "package_version": "features-1.0.0",
  "dataset_file": "data/raw/CortexHR_AI_ML_Dataset.xlsx",
  "attrition_sheet": "attrition_dataset",
  "target_column": "left_within_12m",
  "alternate_target_column": "voluntary_left_within_12m",
  "random_state": 42,
  "test_size": 0.2,
  "artifacts_dir": "artifacts/task2/features",
  "output_dir": "data/processed/task2_features",
  "pipeline_filename": "pipeline.joblib",
  "metadata_filename": "features_metadata.json",
  "split_manifest_filename": "split_manifest.json",
  "numeric_imputation": "median",
  "scaler": "RobustScaler",
  "categorical_imputation": "most_frequent",
  "encoder": "OneHotEncoder(handle_unknown=ignore)",
  "structural_sentinel": 9999.0,
  "monthly_cutoff_month": "2026-04",
  "monthly_pipeline_filename": "monthly_pipeline.joblib",
  "monthly_metadata_filename": "monthly_features_metadata.json",
  "monthly_manifest_filename": "monthly_split_manifest.json",
  "pay_comp_reference": "department median of annual_fixed_pay, fitted on training data only",
  "excluded_columns": [
    "row_id",
    "employee_id",
    "left_within_12m",
    "voluntary_left_within_12m",
    "exit_date",
    "resignation_date",
    "exit_reason",
    "exit_interview_done",
    "fnf_settlement_amount",
    "source"
  ]
}