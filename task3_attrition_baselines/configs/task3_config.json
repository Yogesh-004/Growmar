{
  "package_version": "baselines-1.0.0",
  "dataset_file": "data/raw/CortexHR_AI_ML_Dataset.xlsx",
  "attrition_sheet": "attrition_dataset",
  "benchmark_sheet": "baseline_benchmarks",
  "target_column": "left_within_12m",
  "alternate_target_column": "voluntary_left_within_12m",
  "split_manifest": "artifacts/task2/features/split_manifest.json",
  "task2_config": "task2_feature_pipeline/configs/task2_config.json",
  "random_state": 42,
  "cv_folds": 5,
  "cv_shuffle": true,
  "decision_threshold": 0.5,
  "logreg_solver": "lbfgs",
  "logreg_max_iter": 5000,
  "logreg_c": 1.0,
  "tree_max_depth": 4,
  "selection_primary": "recall_mean",
  "selection_tiebreak": "f1_mean",
  "artifacts_dir": "artifacts/task3",
  "output_dir": "task3_attrition_baselines/reports/generated",
  "report_path": "task3_attrition_baselines/reports/BASELINE_REPORT.md",
  "selected_filename": "selected_config.json"
}
